# HDLForge Frontend Environment Variables (Vercel)
# ===============================================

# URL of the backend deployed on Render (e.g. https://hdlforge-backend.onrender.com)
NEXT_PUBLIC_API_URL=https://hdlforge-backend.onrender.com

# Supabase Auth / Database (Optional if using Supabase client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
