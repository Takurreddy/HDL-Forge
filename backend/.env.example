# HDLForge Backend Environment Variables
# ========================================================

# Local development defaults. For deployment, set ENVIRONMENT=production and
# replace every example value with the real service URL or secret.
ENVIRONMENT=development
DEBUG=true

# PostgreSQL Database connection string
DATABASE_URL=postgresql://hdlforge:hdlforge@localhost:5432/hdlforge

# Allowed origins for CORS (comma-separated or regex)
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=

# Simulator & Execution Sandbox
# Local development can execute directly; production requires the private worker.
HDL_USE_DOCKER=false
HDL_SANDBOX_IMAGE=hdlforge-sandbox:latest
HDL_WORKER_URL=
HDL_WORKER_TOKEN=
HDL_WORKER_MAX_CONCURRENT_JOBS=2
HDL_EXECUTION_RATE_LIMIT_PER_MINUTE=10
HDL_EXECUTION_RATE_LIMIT_PER_HOUR=60
SIMULATOR=icarus
HDL_EXECUTION_TIMEOUT=5
HDL_MEMORY_LIMIT=256
HDL_CPU_LIMIT=5
HDL_PROCESS_LIMIT=64
HDL_MAX_SOURCE_SIZE=50000
HDL_MAX_OUTPUT_SIZE=100000

# Local auth JWT; production must set an explicit random secret of at least 32 characters.
JWT_SECRET=

# AI Tutor powered by Groq API
AI_ENABLED=true
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# (Optional) Supabase Integration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Production: set verified administrator email address(es), comma separated.
ADMIN_EMAILS=
