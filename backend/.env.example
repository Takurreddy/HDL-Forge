# HDLForge Backend Environment Variables (Render / Local)
# ========================================================

# PostgreSQL Database connection string
DATABASE_URL=postgresql://hdlforge:hdlforge@localhost:5432/hdlforge

# Allowed origins for CORS (comma-separated or regex)
CORS_ORIGINS=http://localhost:3000,https://hdl-forge.vercel.app,https://hdlforge.vercel.app
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Simulator & Execution Sandbox
# On Render / Docker containers where iverilog is installed natively, set HDL_USE_DOCKER=false
HDL_USE_DOCKER=false
SIMULATOR=icarus

# JWT Secret for local authentication
JWT_SECRET=change-this-to-a-secure-random-secret-in-production

# AI Tutor powered by Groq API
AI_ENABLED=true
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# (Optional) Supabase Integration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
